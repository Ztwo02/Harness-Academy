{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true, "noEmit": true, "strict": true,
    "allowSyntheticDefaultImports": true, "esModuleInterop": true, "skipLibCheck": true,
    "jsx": "react-jsx", "types": ["node", "vite/client"], "erasableSyntaxOnly": true
  },
  "include": ["server", "shared", "web", "tests", "vite.config.ts"]
}
