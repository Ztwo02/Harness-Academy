{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Academy 课程发布包 v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "repositoryId",
    "commit",
    "courseId",
    "version",
    "title",
    "sourceEvidence",
    "materials",
    "lessons"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "projectId": {
      "$ref": "#/$defs/id"
    },
    "repositoryId": {
      "$ref": "#/$defs/id"
    },
    "commit": {
      "$ref": "#/$defs/oid"
    },
    "courseId": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "sourceEvidence": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/evidence"
      }
    },
    "materials": {
      "type": "object",
      "minProperties": 0,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/material"
      }
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/lesson"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "oid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text",
        "sourceRefs"
      ],
      "properties": {
        "kind": {
          "enum": [
            "fact",
            "inference",
            "advice"
          ]
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "materialRefs": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "symbol",
        "startLine",
        "endLine",
        "blobOid",
        "excerptSha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/text"
        },
        "symbol": {
          "anyOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "type": "null"
            }
          ]
        },
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "blobOid": {
          "$ref": "#/$defs/oid"
        },
        "excerptSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "url",
        "accessedAt",
        "sha256",
        "locator"
      ],
      "properties": {
        "kind": {
          "enum": [
            "official-doc",
            "official-sdk-doc"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "accessedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "locator": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "exercise": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "prompt",
            "explanation",
            "kind",
            "options",
            "correctOption"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "prompt": {
              "$ref": "#/$defs/text"
            },
            "explanation": {
              "$ref": "#/$defs/claim"
            },
            "kind": {
              "const": "single-choice"
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "text"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/id"
                  },
                  "text": {
                    "$ref": "#/$defs/text"
                  }
                }
              }
            },
            "correctOption": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "prompt",
            "explanation",
            "kind",
            "rubric"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "prompt": {
              "$ref": "#/$defs/text"
            },
            "explanation": {
              "$ref": "#/$defs/claim"
            },
            "kind": {
              "const": "trace"
            },
            "rubric": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      ]
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "objectives",
        "priorKnowledge",
        "prerequisiteLessons",
        "concepts",
        "sourceReading",
        "keySymbols",
        "execution",
        "calls",
        "scenario",
        "designRationale",
        "faq",
        "exercises",
        "summary"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "priorKnowledge": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "prerequisiteLessons": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "concepts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "sourceReading": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "keySymbols": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "sourceRef"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/text"
              },
              "sourceRef": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        "execution": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "calls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "scenario": {
          "$ref": "#/$defs/text"
        },
        "designRationale": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "faq": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question",
              "answer"
            ],
            "properties": {
              "question": {
                "$ref": "#/$defs/text"
              },
              "answer": {
                "$ref": "#/$defs/claim"
              }
            }
          }
        },
        "exercises": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/exercise"
          }
        },
        "summary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/claim"
          }
        }
      }
    }
  }
}
