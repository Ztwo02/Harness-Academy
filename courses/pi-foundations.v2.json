      ],
      "prerequisiteLessons": [
        "loop-control"
      ],
      "concepts": [
        {
          "kind": "fact",
          "text": "executeToolCalls 根据配置或工具 executionMode 选择顺序执行；否则走并行分支。",
          "sourceRefs": [
            "tool-dispatch"
          ]
        },
        {
          "kind": "fact",
          "text": "prepareToolCall 按名字查找工具，再准备并校验参数；工具不存在会立即得到错误结果。",
          "sourceRefs": [
            "tool-prepare"
          ]
        }
      ],
      "sourceReading": [
        "tool-dispatch",
        "tool-prepare",
        "tool-execute",
        "tool-finalize",
        "parallel-tools",
        "tool-artifact"
      ],
      "keySymbols": [
        {
          "name": "executeToolCalls",
          "sourceRef": "tool-dispatch"
        },
        {
          "name": "prepareToolCall",
          "sourceRef": "tool-prepare"
        },
        {
          "name": "executePreparedToolCall",
          "sourceRef": "tool-execute"
        },
        {
          "name": "createToolResultMessage",
          "sourceRef": "tool-artifact"
        }
      ],
      "execution": [
        {
          "kind": "fact",
          "text": "工具存在后先 prepareArguments 和 validateToolArguments，再执行可选 beforeToolCall；阻止执行或取消会得到 immediate 错误结果。",
          "sourceRefs": [
            "tool-prepare"
          ]
        },
        {
          "kind": "fact",
          "text": "executePreparedToolCall 调用 tool.execute，并转发执行中的 partialResult。成功得到 isError=false，抛错在 catch 中变为 isError=true；promise 结束后不再接纳更新。",
          "sourceRefs": [
            "tool-execute"
          ]
        },
        {
          "kind": "fact",
          "text": "finalizeExecutedToolCall 可通过 afterToolCall 覆盖结果字段及 isError；该回调抛错也会转为错误结果。",
          "sourceRefs": [
            "tool-finalize"
          ]
        },
        {
          "kind": "fact",
          "text": "emitToolExecutionEnd 携带最终 isError；createToolResultMessage 生成 role=toolResult 的消息，随后发 message_start 与 message_end。",
          "sourceRefs": [
            "tool-artifact"
          ]
        }
      ],
      "calls": [
        {
          "kind": "fact",
          "text": "executeToolCalls 选择 executeToolCallsParallel；该分支按准备顺序安排执行，用 Promise.all 收集结果，按 assistant 原调用顺序发工具消息；执行结束事件可能按完成先后发出。",
          "sourceRefs": [
            "tool-dispatch",
            "parallel-tools"
          ]
        },
