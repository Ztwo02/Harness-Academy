  "lessons": [
    {
      "id": "agent-loop",
      "title": "从输入消息到 Agent Loop",
      "objectives": [
        "画出 Pi 的 CLI、Agent 运行时与模型接口三者的职责边界。",
        "在 agentLoop 的定义中找出事件进入输出流的位置，并解释工具结果怎样进入下一轮。"
      ],
      "priorKnowledge": [
        "会阅读 TypeScript 函数，了解 Promise 与异步事件。"
      ],
      "prerequisiteLessons": [],
      "concepts": [
        {
          "kind": "fact",
          "text": "仓库把交互式 CLI 放在 pi-coding-agent，把工具调用与状态管理放在 pi-agent-core，把多家模型供应商的统一接口放在 pi-ai。",
          "sourceRefs": [
            "packages"
          ]
        },
        {
          "kind": "fact",
          "text": "本章选择低层入口 agentLoop。调用者拿到事件流，后台的 runAgentLoop 接收输入消息、上下文、配置和事件接收函数。",
          "sourceRefs": [
            "entry"
          ]
        }
      ],
      "sourceReading": [
        "entry",
        "packages",
        "context",
        "stream",
        "turn",
        "follow-up"
      ],
      "keySymbols": [
        {
          "name": "agentLoop",
          "sourceRef": "entry"
        },
        {
          "name": "runAgentLoop",
          "sourceRef": "context"
        },
        {
          "name": "streamAssistantResponse",
          "sourceRef": "stream"
        }
      ],
      "execution": [
        {
          "kind": "fact",
          "text": "入口先创建事件流，再启动 runAgentLoop。传给循环的回调会把每个事件推入流，循环完成后以消息列表结束该流。",
          "sourceRefs": [
            "entry"
          ]
        },
        {
          "kind": "fact",
          "text": "runAgentLoop 把新输入追加到已有消息之后，发出 agent_start 和 turn_start，并为每条输入发出消息事件，再把当前上下文交给 runLoop。",
          "sourceRefs": [
            "context"
          ]
        },
        {
          "kind": "fact",
          "text": "生成一次回复时，streamAssistantResponse 可先变换上下文，再把消息转换成模型接口格式，最后调用传入的 streamFunction。",
          "sourceRefs": [
            "stream"
          ]
        },
        {
          "kind": "fact",
          "text": "循环把回复写入上下文，检查停止原因和工具请求。工具返回的消息被追加到 currentContext.messages，随后发出 turn_end。",
          "sourceRefs": [
            "turn"
          ]
        },
        {
          "kind": "fact",
          "text": "内层工作结束后，外层还会检查跟进消息。有跟进则继续，否则退出并发出 agent_end。",
          "sourceRefs": [
            "follow-up"
          ]
        }
      ],
      "calls": [
        {
          "kind": "fact",
          "text": "agentLoop → runAgentLoop → runLoop。第一段连接事件流，第二段在准备好消息后启动循环。",
          "sourceRefs": [
            "entry",
            "context"
          ]
        },
        {
          "kind": "fact",
          "text": "runLoop 调用 streamAssistantResponse 取得模型回复。在有工具请求且回复未因错误或中止结束时，循环按停止原因执行工具或生成工具失败结果。",
          "sourceRefs": [
            "turn",
            "stream"
          ]
        }
      ],
      "scenario": "教学场景：用户问“这个项目用哪个命令构建？”假设模型请求读取 package.json，沿证据查看消息如何进入上下文、工具结果何时写回，以及 UI 从哪里收到事件。",
      "designRationale": [
        {
          "kind": "inference",
          "text": "从事件回调与模型流函数分别作为参数传入可以推断，两条接口允许上层分别决定怎样展示事件、怎样获取模型回复。",
          "sourceRefs": [
            "entry",
            "stream"
          ]
        },
        {
          "kind": "advice",
          "text": "自己实现教学版循环时，可以先记录收到的事件，再替换模型流函数，以便分别检查消息顺序和模型边界。",
          "sourceRefs": [
            "entry",
            "stream"
          ]
        }
      ],
      "faq": [
        {
          "question": "调用 agentLoop 时，要等模型回答完才能拿到事件流吗？",
          "answer": {
            "kind": "fact",
            "text": "不用。入口启动异步任务后直接返回 stream；任务完成时的回调才调用 stream.end。",
            "sourceRefs": [
              "entry"
            ]
          }
        },
        {
          "question": "一次工具返回就一定表示整次学习场景已经结束吗？",
          "answer": {
            "kind": "fact",
            "text": "工具结果先被加入上下文，外层还会检查跟进消息。turn_end 和 agent_end 在源码中是不同位置发出的事件。",
            "sourceRefs": [
              "turn",
              "follow-up"
            ]
          }
        }
      ],
      "exercises": [
        {
          "id": "event-bridge",
          "kind": "single-choice",
          "prompt": "在 agentLoop 的入口中，哪一步把循环产生的事件交给调用者持有的事件流？",
          "options": [
            {
              "id": "append",
              "text": "把 prompts 追加到 currentContext.messages"
            },
            {
              "id": "push",
              "text": "在传给 runAgentLoop 的回调中调用 stream.push(event)"
            },
            {
              "id": "finish",
              "text": "收到消息列表时调用 stream.end(messages)"
            }
          ],
          "correctOption": "push",
          "explanation": {
            "kind": "fact",
            "text": "第 45–47 行的回调转发每一个事件。追加 prompts 是整理输入，stream.end 则标志异步任务完成。",
            "sourceRefs": [
              "entry",
              "context"
            ]
          }
        }
      ],
      "summary": [
        {
          "kind": "fact",
          "text": "从入口的事件流沿 runAgentLoop 进入循环，可以依次看到输入、模型边界、工具结果与终止事件；每一步都能在同一固定版本上复核。",
          "sourceRefs": [
            "entry",
            "context",
            "stream",
            "turn",
            "follow-up"
          ]
        }
      ]
    }
  ]
